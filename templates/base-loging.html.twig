
<!DOCTYPE html>
<html lang="fr">
{# Gestion du label rôle en fonction du rôle de l'utilisateur #}
{% if is_granted('ROLE_ADMIN') %}
    {% set role = "Administrateur" %}
    {% set role = "DGAFP USER" %}
{% elseif is_granted('DGAFP USER') %}

{% endif %}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="apple-touch-icon" sizes="76x76" href="{{ asset('logo-bosongo.840f550f.jpg') }}">
    <link rel="icon" type="image/png" href="{{path('bac_homepage') }}">
    <title>
Clever-School
    </title>
    <!--     Fonts and icons     -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet" />
    <!-- Nucleo Icons -->
    <!-- Font Awesome Icons -->
    <script src="https://kit.fontawesome.com/42d5adcbca.js" crossorigin="anonymous"></script>

    <!-- CSS Files -->
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        {{ encore_entry_link_tags('school-dashboard') }}
        {{ encore_entry_link_tags('flash-bag-index') }}

    {% endblock %}
</head>


{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
    {{ encore_entry_script_tags('flash-bag') }}
{% endblock %}
<body class="g-sidenav-show   bg-gray-100">
<div class="container position-sticky z-index-sticky top-0">
    <div class="row">
        <div class="col-12">
            <!-- Navbar -->
            <nav class="navbar navbar-expand-lg blur border-radius-lg top-0 z-index-3 shadow position-absolute mt-4 py-2 start-0 end-0 mx-4">
                <div class="container-fluid">
                    <a class="navbar-brand font-weight-bolder ms-lg-0 ms-3 " href="{{ path('bac_homepage') }}">
                        Clever-School
                    </a>
                    <button class="navbar-toggler shadow-none ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#navigation" aria-controls="navigation" aria-expanded="false" aria-label="Toggle navigation">
              <span class="navbar-toggler-icon mt-2">
                <span class="navbar-toggler-bar bar1"></span>
                <span class="navbar-toggler-bar bar2"></span>
                <span class="navbar-toggler-bar bar3"></span>
              </span>
                    </button>
                    <div class="collapse navbar-collapse" id="navigation">
                        <ul class="navbar-nav mx-auto">
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center me-2 active" aria-current="page" href="{{ path('bac_homepage') }}">
                                    <i class="fa fa-chart-pie opacity-6 text-dark me-1" aria-hidden="true"></i>
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link me-2" href="{{ path('utilisateur_new') }}">
                                    <i class="fas fa-user-circle opacity-6 text-dark me-1" aria-hidden="true"></i>
                        Créer un compte
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link me-2" href="{{ path('app_login') }}">
                                    <i class="fas fa-key opacity-6 text-dark me-1" aria-hidden="true"></i>
                       Connexion
                                </a>
                            </li>
                        </ul>
                        <ul class="navbar-nav d-lg-block d-none">
                            <li class="nav-item">
                                <a href="https://www.creative-tim.com/product/argon-dashboard" class="btn btn-sm mb-0 me-1 btn-primary">Utilisation et Faq</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <!-- End Navbar -->
        </div>
    </div>
</div>
<div class="container">
    <button class="navbar-toggler shadow-none ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#navigation" aria-controls="navigation" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon mt-2">
          <span class="navbar-toggler-bar bar1"></span>
          <span class="navbar-toggler-bar bar2"></span>
          <span class="navbar-toggler-bar bar3"></span>
        </span>
    </button>
    <div class="collapse navbar-collapse" id="navigation">
        <ul class="navbar-nav mx-auto">
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center me-2 active" aria-current="page" href="../pages/dashboard.html">
                    <i class="fa fa-chart-pie opacity-6  me-1" aria-hidden="true"></i>
                    Clever-School
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link me-2" href="../pages/profile.html">
                    <i class="fa fa-user opacity-6  me-1" aria-hidden="true"></i>
                    Profile
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link me-2" href="../pages/sign-up.html">
                    <i class="fas fa-user-circle opacity-6  me-1" aria-hidden="true"></i>
                    Sign Up
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link me-2" href="../pages/sign-in.html">
                    <i class="fas fa-key opacity-6  me-1" aria-hidden="true"></i>
                    Se connecter
                </a>
            </li>
        </ul>
        <ul class="navbar-nav d-lg-block d-none">
            <li class="nav-item">
                <a href="https://www.creative-tim.com/product/argon-dashboard" class="btn btn-sm mb-0 me-1 bg-gradient-light">Free Download</a>
            </li>
        </ul>
    </div>
</div>
</nav>
<main class="main-content mt-0 ps">
    <section>
        <div class="page-header min-vh-100">
            <div class="container">
                <div class="row">
                    <div class="col-xl-4 col-lg-5 col-md-7 d-flex flex-column mx-lg-0 mx-auto">
                        <div class="card card-plain">
                            <div class="card-header pb-0 text-start">
                                <h4 class="font-weight-bolder">Se connecter</h4>
                                <p class="mb-0">Suivez les infos pour vous connecter
                                </p>
                            </div>
                            {% if error.message is defined %}
                                <div class="has-error">
                                    <label class="control-label has-error" for="inputError">
                                        <i class="fa fa-times-circle"></i>
                                        {% if error is instanceOfLockedException %}
                                            {{ error.message }},
                                            ou bien contacter l'administrateur sur :
                                            <a href="https://cisirh.service-now.com/" class="text-center">
                                               MBEKATEAM
                                            </a>
                                        {% else %}
                                            {{ error.message|trans(error.messageData, 'security') }}
                                        {% endif %}
                                    </label>
                                </div>
                            {% endif %}
                            <div class="card-body">
                                {% if error.message is defined %}
                                    <div class="has-error">
                                        <label class="control-label has-error" for="inputError">
                                            <i class="fa fa-times-circle"></i>
                                            {% if error is instanceOfLockedException %}
                                                {{ error.message }},
                                                ou bien contacter l'administrateur sur :
                                                <a href="https://cisirh.service-now.com/" class="text-center">
                                                    CISIRH NOW
                                                </a>
                                            {% else %}
                                                {{ error.message|trans(error.messageData, 'security') }}
                                            {% endif %}
                                        </label>
                                    </div>
                                {% endif %}
                                <form method="post" role="form">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                                    <div class="mb-3">

                                        <input type="email" class="form-control form-control-lg" placeholder="Email" id="username" name="email"
                                               value="{{ last_username }}" required="required" autofocus>
                                    </div>
                                    <div class="mb-3">
                                        <input type="password" id="password" name="password" required="required" class="form-control form-control-lg"
                                               placeholder="Mot de passe" aria-label="Password"/>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input type="checkbox" id="remember_me" name="_remember_me" class="form-check-input" >
                                        <label class="form-check-label" for="rememberMe">Se souvenir de moie</label>
                                    </div>

                                    <div class="text-center">
                                        <button type="submit"  class="btn btn-lg btn-primary btn-lg w-100 mt-4 mb-0">Se
                                            connecter</button>
                                    </div>
                                </form>

                            </div>
                            <div class="card-footer text-center pt-0 px-lg-2 px-1">
                                <p class="mb-4 text-sm mx-auto">
                                   Vous avez pas encore de compte ?
                                    <a href="{{path('utilisateur_new')}}" class="text-primary text-gradient font-weight-bold">Créer un compte</a>
                                </p>
                                {% block pwd_oublie %}
                                    <a href="{{ path('demande_reinitialisation_mot_de_passe') }}">Mot de passe oublié?</a><br>
                                {% endblock pwd_oublie %}
                            </div>
                        </div>
                    </div>
                    <div class="col-6 d-lg-flex d-none h-100 my-auto pe-0 position-absolute top-0 end-0 text-center justify-content-center flex-column">
                        <div class="position-relative bg-gradient-primary h-100 m-3 px-7 border-radius-lg d-flex flex-column justify-content-center overflow-hidden" style="background-image: url('{{ asset('build/images/bg-left@2x.png') }}');
                                background-size: cover;">
                            <span class="mask bg-gradient-primary opacity-6"></span>
                            <h4 class="mt-5 text-white font-weight-bolder position-relative">

                                <div class="snip1326">
                                    <div class="icon"><i class="ion-android-star-outline"></i></div>
                                    <img src="{{ asset('build/images/Illustration_cc@2x.png') }}">
                                </div>

                            </h4>
                            <p class="text-white position-relative"> .</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <div class="ps__rail-x" style="left: 0px; bottom: 0px;"><div class="ps__thumb-x" tabindex="0" style="left: 0px; width: 0px;"></div></div><div class="ps__rail-y" style="top: 0px; right: 0px;"><div class="ps__thumb-y" tabindex="0" style="top: 0px; height: 0px;"></div></div></main>
</body>
</html>


