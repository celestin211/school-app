{% extends "base.html.twig" %}

{% block frameTitle %}Messagerie{% endblock frameTitle %}

{% block pageTitle %} <i class=" fa fa-envelope"></i> Messagerie {% endblock pageTitle %}


{% block content %}



<div class="row ">

  <!-- Content Wrapper. Contains page content -->
{#   <div class="content-wrapper">#}
    <!-- Main content -->
    <section class="content">
      <div class="row">
        
        {% block mesDossiers %}
	        <div class="col-md-3">
	
	          <div class="box box-solid">
	            <div class="box-header with-border">

	            </div>
	            <div class="box-body no-padding">
	              <ul class="nav nav-pills nav-stacked">
	                <li class="{{ boiteReceptionClass }}">
	                  <a href="{{ path('messagerie')}}">
	                  	<i class="fa fa-inbox"></i> Boîte de réception
	                  	<!-- s'il n'y a pas de messages non lus, on n'affiche pas la notification en vert du nombre de messages non lus -->
        				{% if nbMessagesNonLus > 0 %}
							{% set messages = (nbMessagesNonLus == 1) ? 'message' : 'messages' %}
	                  		<small class="label pull-right bg-green">{{ nbMessagesNonLus }} {{ messages }}</small>
	                  	{% endif %}
	                  </a>
	                </li>
	               
	                <li class="{{ favorisClass }}"><a href="{{ path('message_favoris')}}"><i class="fa fa-star text-yellow"></i> Mes favoris </a></li>
	                
	                <li class="{{ corbeilleClass }}"><a href="{{ path('message_corbeille')}}"><i class="fa fa-trash-o"></i> Corbeille </a></li>
	                
	              </ul>
	            </div>
	            <!-- /.box-body -->
	          </div>
	          <!-- /. box -->
	        </div>
        {% endblock mesDossiers %}

      </div>
      <!-- /.row -->
    </section>
    <!-- /.content -->
{#   </div>#}
  <!-- /.content-wrapper -->
</div>


{% endblock content %}	 

