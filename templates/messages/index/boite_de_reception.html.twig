{% extends "Message/index.base.messagerie.html.twig" %}


{% block content %}

{% set boiteReceptionClass = "active" %}
{% set favorisClass = "" %}
{% set corbeilleClass = "" %}



<div class="row ">

    <!-- Main content -->
    <section class="content">
      <div class="row">

     {% block mesDossiers %}
			{{ parent() }}
     {% endblock mesDossiers %}


        <!-- /.col -->
        <div class="col-md-9">
          <div class="box box-primary">
            <div class="box-header with-border">
              <h3 class="box-title">
	              {% block titre %}
	              Boîte de réception
	              {% endblock titre %}
              </h3>

              <div class="box-tools pull-right">

                <div class="has-feedback">

				 		{{ render(controller('App\\Controller\\MessageController::createSearchForm')) }}
			          <!-- /.search form -->

                </div>

              </div>
              <!-- /.box-tools -->
            </div>

            {{ form_start(form) }}


            <!-- /.box-header -->
            <div class="box-body no-padding">
              <div class="mailbox-controls">
                <!-- Check all button -->
                <button type="button" class="btn btn-default btn-sm checkbox-toggle" title="Sélectionner tout"><i class="fa fa-square-o"></i>
                </button>
                <div class="btn-group">
                  <button type="submit" class="btn btn-default btn-sm" title="Supprimer les messages sélectionnés"><i class="fa fa-trash-o"></i></button>
                </div>
                <!-- /.btn-group -->
                 {% block icone_actualiser_haut %}
                		<a href="{{ path('messagerie')}}" class="btn btn-default btn-sm" title="Actualiser la messagerie"> <i class="fa fa-refresh"></i></a>
                 {% endblock icone_actualiser_haut %}

                <div class="pull-right">
                  <b>{{ indicePremierMessage }}-{{ indiceDernierMessage }}</b> sur <b>{{ nbMessages }} </b>
                    <div class="btn-group">
                        <a href="{% block icone_precedent_haut %} {% if page == 1 %} # {% else %} {{ path('messagerie' , {"page":page-1})}} {% endif %}  {% endblock icone_precedent_haut %}" class="btn btn-default btn-sm" title="Précédent" {% if page == 1 %} disabled {% endif %}>
                            <i class="fa fa-chevron-left"></i>
                        </a>

                        <a href="{% block icone_suivant_haut %} {% if page == nbPages  or nbPages == 0  %} # {% else %}  {{ path('messagerie' , {"page":page+1})}} {% endif %} {% endblock icone_suivant_haut %}" class="btn btn-default btn-sm" title="Suivant" {% if page == nbPages  or nbPages == 0  %} disabled {% endif %}>
                            <i class="fa fa-chevron-right"></i>
                        </a>

                    </div>
                  <!-- /.btn-group -->
                </div>
                <!-- /.pull-right -->
              </div>



              <div class="table-responsive mailbox-messages">
                <table class="table table-hover ">
                  <tbody>
                  {% block messages %}
	                  {% if messages|length == 0 %}
	                  	<tr>
	                  		<td>
	                  			Votre boîte de réception est vide
	                  		</td>
	                  	</tr>

	                  {% else %}

		                  {% for message in messages %}
			                  <tr  {% if message.lu == 0 %} style="background-color: #f5f3f3;" {% endif %}>

			                    <td>{{ form_row(form.children["message_"~message.id]) }}</td>
			                    <td class="mailbox-star">
			                    	<a href="">
			                    		<!-- Si le message fait partie des favoris, on affiche l'étoile en jaune (ajouter '-o' au nom de la classe) -->
			                    		<i class="fa  text-yellow fa-star{% if message.favoris == 0 %}-o{% endif %}" id="{{ message.id }}"> </i>
			                    	</a>
			                    </td>
			                    <td class="mailbox-name"><a href="{{ path('show_message_boite_reception', {'id':message.id})}}"> {{ message.expediteur.prenom | title}} {{message.expediteur.nom | upper}}</a></td>
			                    <td class="mailbox-subject">
			                    {% if message.lu == 0 %} <b> {% endif %}
			                    	<a href="{{ path('show_message_boite_reception', {'id':message.id})}}">{{ message.objetMessage }} </a>
			                   {% if message.lu == 0 %} </b> {% endif %}
			                    </td>

			                     <td class="mailbox-attachment">
			                    	{% if message.piecesJointes | length > 0 %}
			                   			<i class="fa fa-paperclip"></i>
									{% endif %}
								</td>

			                    <td class="mailbox-date">
		          						{{ message.dateEnvoi |date("d/m/Y H:i")}}
								</td>

			                  </tr>
		                  {% endfor %}

	                  {% endif %}
	                {% endblock messages %}
                  </tbody>
                </table>
                <!-- /.table -->
              </div>
              <!-- /.mail-box-messages -->
            </div>
            <!-- /.box-body -->
            <div class="box-footer no-padding">
              <div class="mailbox-controls">
                <!-- Check all button -->
                <button type="button" class="btn btn-default btn-sm checkbox-toggle" title="Sélectionner tout"><i class="fa fa-square-o"></i>
                </button>
                <div class="btn-group">
                  <button type="submit" class="btn btn-default btn-sm" title="Supprimer les messages sélectionnés"><i class="fa fa-trash-o"></i></button>
                </div>
                <!-- /.btn-group -->

                {% block icone_actualiser_bas %}
                	<a href="{{ path('messagerie')}}" class="btn btn-default btn-sm" title="Actualiser la messagerie"> <i class="fa fa-refresh"></i></a>
                {% endblock icone_actualiser_bas %}

                <div class="pull-right">

                  <b>{{ indicePremierMessage }}-{{ indiceDernierMessage }}</b>  sur  <b>{{ nbMessages }} </b>
                  <div class="btn-group">
                    <a href="{% block icone_precedent_bas %} {% if page == 1 %} # {% else %} {{ path('messagerie' , {"page":page-1})}} {% endif %}  {% endblock icone_precedent_bas %}" class="btn btn-default btn-sm" title="Précédent" {% if page == 1 %} disabled {% endif %}>
                    	<i class="fa fa-chevron-left"></i>
                    </a>

                    <a href="{% block icone_suivant_bas %} {% if page == nbPages  or nbPages == 0  %} # {% else %}  {{ path('messagerie' , {"page":page+1})}} {% endif %} {% endblock icone_suivant_bas %}" class="btn btn-default btn-sm" title="Suivant" {% if page == nbPages  or nbPages == 0  %} disabled {% endif %}>
                    	<i class="fa fa-chevron-right"></i>
                    </a>

                  </div>
                  <!-- /.btn-group -->
                </div>
                <!-- /.pull-right -->
              </div>
            </div>
          </div>
          <!-- /. box -->
        </div>
        <!-- /.col -->
      </div>
      <!-- /.row -->
    </section>
    <!-- /.content -->
  <!-- /.content-wrapper -->
</div>
    <div id="message_update_favoris" data-action="{{ path('message_update_favoris') }}"></div>

{{ form_end(form) }}

{% endblock content %}
{% block javascripts %}
{{ parent() }}
{{ encore_entry_script_tags('message.index.reception') }}
{% endblock javascripts %}
