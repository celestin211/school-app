{% extends "Message/index.base.messagerie.html.twig" %}


{# initialiser l'onglet actif  #}
{% set corbeilleClass = "" %}
{% set boiteReceptionClass = "" %}
{% set favorisClass = "active" %}



{% block content %}

{{ form_start(form) }}

<div class="row ">

    <!-- Main content -->
    <section class="content">
      <div class="row">
      
     {% block mesDossiers %}
			{{ parent() }}
     {% endblock mesDossiers %}
     
     
         <div class="col-md-9">
          <div class="box box-primary">
            <div class="box-header with-border">
              <h3 class="box-title">
              	Boîte de réception
              </h3>

            </div>
            <!-- /.box-header -->
            <div class="box-body no-padding">
              <div class="mailbox-read-info">
                <h3><b>{{ message.objetMessage}}</b></h3> 
                <h5>De : <b>{{ message.expediteur.prenom | title}}  {{message.expediteur.nom | upper}}</b> &lsaquo;{{ message.expediteur.email}}&rsaquo;
                  <span class="mailbox-read-time pull-right">{{ message.dateEnvoi |date("d/m/Y H:i")}}</span></h5>
              </div>
              <!-- /.mailbox-read-info -->
              <div class="mailbox-controls">
                
	                <div class="btn-group pull-left">
	
						<a href="{{ path('message_favoris')}}" class="btn btn-default btn-sm" title="Mes favoris">
	                    	<i class="fa fa-reply"></i>
	                    </a>	
								
	                  	<button type="submit" class="btn btn-default btn-sm" title="Supprimer ce message"><i class="fa fa-trash-o"></i></button>
				           
					</div>	
				 
				    <div class="mailbox-star pull-right">
                    	<a href="">
                    		<!-- Si le message fait partie des favoris, on affiche l'étoile en jaune (ajouter '-o' au nom de la classe) -->
                    		<i class="fa  text-yellow fa-star{% if message.favoris == 0 %}-o{% endif %}" id="{{ message.id }}" style="  margin-right: 1cm;"> </i>
                    	</a>
                    </div>
              </div>
		                    
              <!-- /.mailbox-controls -->
              <div class="mailbox-read-message">
               		<!-- Le raw permet d'interpreter le code html et de ne pas l'afficher directement-->
					{{ message.contenuMessage | raw }}
              </div>
              <!-- /.mailbox-read-message -->
            </div>
            <!-- /.box-body -->
            <div class="box-footer">
              <ul class="mailbox-attachments clearfix">
				  {% set piecesId=[] %}
                {% for pieceJointe in message.piecesJointes %}
					{% set piecesId= piecesId|merge(["PJ" ~ pieceJointe.id ]) %}
                
	                <li  id={{ "PJ" ~ pieceJointe.id }}>
	                
	          <!-- le filtre file_extension récupère l'extension de la pièce jointe -->
	                {% set pieceJointeExtension = pieceJointe.nom | file_extension  %}


	          <!-- afficher une icône associée selon l'extension de la pièce jointe -->
	                {% if pieceJointeExtension == "pdf" %}
	                	<span class="mailbox-attachment-icon"><i class="fa fa-file-pdf-o"></i></span>
	                	
	                {% elseif pieceJointeExtension == "xls" or pieceJointeExtension == "xlsx" %}
	                	<span class="mailbox-attachment-icon"><i class="fa fa-file-excel-o"></i></span>
	                
	                {% elseif pieceJointeExtension == "doc" or pieceJointeExtension == "docx" %}
	                	<span class="mailbox-attachment-icon"><i class="fa fa-file-word-o"></i></span>	
	                
	                {% elseif pieceJointeExtension == "png" or pieceJointeExtension =="jpeg" or pieceJointeExtension == "jpg"  %}
	                	<span class="mailbox-attachment-icon has-img"><img src="" alt=""></span>
	                	
	                {% else %}
	                	<span class="mailbox-attachment-icon"><i class="fa fa-file-o"></i></span>
	                
	                {% endif %}
					
	                  <div class="mailbox-attachment-info" >
	                    
					<!-- Si la pièce jointe est une image, on l'affiche autrement  -->
					
		                  {% if pieceJointeExtension == "png" or pieceJointeExtension =="jpeg" or pieceJointeExtension == "jpg"  %}  
		                    	<a href="{{path('bac_getFile', {'id':  pieceJointe.id, 'path':  pieceJointe.path})}}" class="mailbox-attachment-name">
		                    		<i class="fa fa-camera"></i>
		                    		{{ pieceJointe.nom }}
		                    	</a>
		                  
		                  {% else %}  
		                  	<a href="{{path('bac_getFile', {'id':  pieceJointe.id, 'path':  pieceJointe.path})}}" class="mailbox-attachment-name">
		                  		<i class="fa fa-paperclip"></i> 
		                  		{{ pieceJointe.nom }}
		                  	</a>
		                  {% endif %}  
	                        <span class="mailbox-attachment-size">
{#                 					 1,245 KB #}
	                        </span>
	                       
	                  </div>
	                </li>
                
                {% endfor %}

              </ul>
            </div>
            
          </div>
          <!-- /. box -->
        </div>
      </div><!-- row -->
     </section>
     </div>
	<div id="pieces-jointes-id" data-pieces="{{ piecesId|json_encode|e('html_attr') }}"></div>
	<div id="message-update-favoris" data-action="{{ path('message_update_favoris') }}"></div>
{{ form_end(form) }}     

{% endblock content %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('message.show.favoris') }}
{% endblock javascripts %}

	

		