{% block generationMenu %}
    {# ----------------------------- #}
    {# MACRO DE GENERATION DES MENUS #}
    {# ------------------------------ #}
    {# macros de génération du menu #}

    {% macro menu_links(items) %}
        {% for item in items %}

            {% if item['href'] is defined and item['href'] is not null %}
                {% set href = path(item['href']) %}
            {% else %}
                {% set href = "javascript:void(0)" %}
            {% endif %}

            {% set class="" %}
            {% set classes="" %}

            {% if item['sousMenu'] %}
                {% set classes = classes ~ 'treeview ' %}
            {% endif %}

            {% if item['active'] %}
                {% set classes = classes ~ 'active' %}
            {% endif %}

            {% if item['sousMenu'] or item['active'] %}
                {% set class = "class=\"" ~ classes|trim ~ "\"" %}
            {% endif %}

            <li {{ class | raw}}>
                <a id="menu_{{ item['libelle'] }}" href="{{ href }}">
                    <i class="fa {{ item['icone'] }}"></i> <span>{{ item['libelle'] }}</span>
                    {% if item['sousMenu'] is not null %}
                        <span class="pull-right-container">
                            <i class="fa fa-angle-left pull-right"></i>
                        </span>
                    {% endif %}
                </a>

                {% if item['sousMenu'] is not null %}
                    <ul class="treeview-menu">
                        {{ _self.menu_links(item['sousMenu']) }}
                    </ul>
                {% endif %}
            </li>

        {% endfor %}
    {% endmacro %}
{% endblock generationMenu %}
