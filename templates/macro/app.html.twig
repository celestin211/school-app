{% macro modal(class, idModal, title, message, icon, form) %}
	<div class="modal fade modal-{{ class }}" id="{{ idModal }}" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="exampleModalLabel">Modal title</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="modal-body">
					...  {{ message | raw}}
				</div>
				<div class="modal-footer">
					{{ form_start(form, {'attr': {'id': 'form_' ~ idModal}}) }}
					<button type="button" class="btn bg-gradient-secondary" data-bs-dismiss="modal" >Close</button>
					<button type="button" class="btn bg-gradient-primary" id="{{ idModal }}_submit"   onclick="this.disabled=true;submit();">Save changes</button>
					{{ form_end(form) }}
				</div>
			</div>
		</div>
	</div>
{% endmacro %}