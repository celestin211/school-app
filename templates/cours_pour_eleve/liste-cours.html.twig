                                <th class="text-secondary text-xs font-weight-semibold opacity-7 ps-1">Civilité</th>
                                <th class="text-secondary text-xs font-weight-semibold opacity-7 ps-1">Civilité</th>
                                <th class="text-center text-secondary text-xs font-weight-semibold opacity-7">Nom</th>
                                <th class="text-center text-secondary text-xs font-weight-semibold opacity-7 ">Prénom</th>
                                <th class="text-center text-secondary text-xs font-weight-semibold opacity-7 ">Courriel</th>
                                <th class="text-center text-secondary text-xs font-weight-semibold opacity-7 ">Rôles</th>
                                <th class="text-center text-secondary text-xs font-weight-semibold opacity-7 ps-1">Statut</th>
                                <th class="text-center text-secondary text-xs font-weight-semibold opacity-7 ps-1">Action</th>
                                </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                        <div class="border-top py-3 px-3 d-flex align-items-center">
                            <p class="font-weight-semibold mb-0 text-dark text-sm">Page 1 of 10</p>
                            <div class="ms-auto">
                                <button class="btn btn-sm btn-white mb-0">Previous</button>
                                <button class="btn btn-sm btn-white mb-0">Next</button>
                            </div>
