{% extends "base.html.twig" %}

{% import _self as modals %}

{% block frameTitle %}Liste des utilisateurs{% endblock frameTitle %}

{% block pageTitle %}<i class="fa fa-user"></i> Liste des utilisateurs{% endblock pageTitle %}


